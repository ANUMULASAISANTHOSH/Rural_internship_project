# =============================================================================
# AQUILA - Environment Configuration Template
# Copy to .env for local runtime configuration
# Note: This is an academic research prototype; no real credentials are used.
# =============================================================================

# Application Server Settings
AQUILA_ENV=development
AQUILA_HOST=127.0.0.1
AQUILA_PORT=8000
AQUILA_LOG_LEVEL=INFO

# Database Configuration
# Defaults to local SQLite database in project root
AQUILA_DB_PATH=aquila_mvp.db

# CORS Configuration
# Comma-separated list of allowed origins (e.g., http://localhost:8501 for Streamlit)
AQUILA_CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:8000,http://127.0.0.1:8000

# Geospatial Simulation Defaults
AQUILA_DEFAULT_RAINFALL_RATE_MM_HR=25.0
AQUILA_ROUTING_DEFAULT_LAMBDA=3.0
AQUILA_ROUTING_INCIDENT_PENALTY_RADIUS_M=200.0

# Pilot Catchment Boundaries (Manikonda, Hyderabad)
AQUILA_BBOX_MIN_LAT=17.360
AQUILA_BBOX_MAX_LAT=17.435
AQUILA_BBOX_MIN_LON=78.330
AQUILA_BBOX_MAX_LON=78.415

